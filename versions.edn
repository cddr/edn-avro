{:aliases
 {;; --- Avro Versions ---
  :avro-1.8  {:extra-deps {org.apache.avro/avro {:mvn/version "1.8.2"}}}
  :avro-1.9  {:extra-deps {org.apache.avro/avro {:mvn/version "1.9.2"}}}
  :avro-1.10 {:extra-deps {org.apache.avro/avro {:mvn/version "1.10.2"}}}
  :avro-1.11 {:extra-deps {org.apache.avro/avro {:mvn/version "1.11.3"}}}
  :avro-1.12 {:extra-deps {org.apache.avro/avro {:mvn/version "1.12.0"}}}

  ;; --- Confluent Versions ---
  ;; COMPATIBLE COMBINATIONS (tested and working):
  ;;   v5:  avro-1.9, avro-1.10, avro-1.11
  ;;   v6:  avro-1.10, avro-1.11, avro-1.12
  ;;   v7:  avro-1.10, avro-1.11, avro-1.12
  ;;   v8:  avro-1.12 (only)
  ;;
  ;; Incompatible combinations are not supported due to JVM-level version conflicts:
  ;;   - avro-1.8 incompatible with all Confluent versions (Jackson API changes)
  ;;   - avro-1.9 incompatible with v7, v8 (missing Avro classes)
  ;;   - avro-1.12 incompatible with v5 (Schema.toJson() method signature)
  ;;   - avro < 1.12 incompatible with v8 (missing NameValidator class)

  :v5 {:extra-deps {io.confluent/kafka-avro-serializer {:mvn/version "5.5.15"}
                    io.confluent/kafka-schema-registry-client {:mvn/version "5.5.15"}}}
  :v6 {:extra-deps {io.confluent/kafka-avro-serializer {:mvn/version "6.2.15"}
                    io.confluent/kafka-schema-registry-client {:mvn/version "6.2.15"}}}
  :v7 {:extra-deps {io.confluent/kafka-avro-serializer {:mvn/version "7.9.0"}
                    io.confluent/kafka-schema-registry-client {:mvn/version "7.9.0"}}}
  :v8 {:extra-deps {io.confluent/kafka-avro-serializer {:mvn/version "8.2.0"}
                    io.confluent/kafka-schema-registry-client {:mvn/version "8.2.0"}}}}}
